{
  "name": "coliner",
  "version": "0.1.0",
  "description": "YAML/JSON-driven command line tool builder with event triggering and smart positional assignment, running on Bun",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "coliner": "./bin/coliner.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "bun run ./bin/coliner.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "cli",
    "bun",
    "yaml",
    "command-line",
    "parser",
    "events",
    "arguments"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.8.2"
  }
}
