{
  "name": "coliner",
  "version": "0.1.0",
  "description": "YAML/JSON-driven command line tool builder with event triggering and smart positional assignment, running on Bun",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "coliner": "./bin/coliner.ts"
  },
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "start": "bun run ./bin/coliner.ts",
    "test": "bun test",
    "test:e2e": "bun test test/e2e.test.ts",
    "test:watch": "bun test --watch",
    "typecheck": "bun check"
  },
  "keywords": [
    "cli",
    "bun",
    "yaml",
    "command-line",
    "parser",
    "events",
    "arguments"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.2.4",
    "eslint": "^10.12.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.2"
  }
}
