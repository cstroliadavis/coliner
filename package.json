{
  "name": "coliner",
  "version": "0.1.0",
  "description": "YAML/JSON-driven command line tool builder with event triggering and smart positional assignment, running on Bun",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "coliner": "./bin/coliner.ts"
  },
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "bun run ./bin/coliner.ts",
    "test": "bun test",
    "test:e2e": "bun test test/e2e.test.ts",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "bun",
    "yaml",
    "command-line",
    "parser",
    "events",
    "arguments"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.2.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
