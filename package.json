{
  "name": "coliner",
  "version": "0.1.0",
  "description": "YAML/JSON-driven command line tool builder with event triggering and smart positional assignment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coliner": "./bin/coliner.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
